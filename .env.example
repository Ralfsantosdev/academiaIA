# API Keys e Variáveis Sensíveis

# Chave secreta JWT (Mude para uma string aleatória segura em produção)
SECRET_KEY="sua-chave-secreta-jwt-aqui"  # Mude para uma string aleatória segura em produção (mín. 16 caracteres)

# Chave de Integração OpenAI
OPENAI_API_KEY="sk-sua-chave-aqui"

# Token de Integração do Mercado Pago (produção ou sandbox)
MERCADOPAGO_ACCESS_TOKEN="seu-access-token-aqui"

# Integração WhatsApp (Evolution API)
# URL completa da Evolution API: {SERVER_URL}/message/sendText/{instance}
# Ex: https://evo-api.onrender.com/message/sendText/whatsapp-instance
# Crie a instance no manager em {SERVER_URL}/manager
WHATSAPP_API_KEY="sua-api-key-aqui"
WHATSAPP_API_URL="https://evo-api.onrender.com/message/sendText/whatsapp-instance"

# URLs do sistema (usado pelo Mercado Pago para redirects e webhooks)
FRONTEND_URL="http://localhost:5173"
API_BASE_URL="http://localhost:8000"

# Senha inicial dos usuários criados pelo seed (mín. 8 caracteres)
# Obligatória em produção; sem ela o seed gera uma aleatória e imprime no log
INITIAL_ADMIN_PASSWORD=""
